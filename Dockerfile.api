# ==========================================
# Hedger Backend API - Production Dockerfile
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9

# Copy root workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/format/package.json ./packages/format/
COPY packages/valuation/package.json ./packages/valuation/
COPY packages/charts/package.json ./packages/charts/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY packages ./packages
COPY apps/api ./apps/api
COPY tsconfig.json ./

# Build packages and API
RUN pnpm --filter "@hedger/types" run build || true
RUN pnpm --filter "@hedger/format" run build || true
RUN pnpm --filter "@hedger/valuation" run build || true
RUN pnpm --filter "@hedger/api" run build

# ==========================================
# Production Runner Image
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hedger

# Copy built application and production dependencies
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

USER hedger

EXPOSE 3001

CMD ["node", "apps/api/dist/server.js"]
