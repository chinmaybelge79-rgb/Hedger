# ==========================================
# Hedger Web Frontend - Production Dockerfile
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9

# Copy workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/format/package.json ./packages/format/
COPY packages/valuation/package.json ./packages/valuation/
COPY packages/charts/package.json ./packages/charts/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy sources
COPY packages ./packages
COPY apps/web ./apps/web
COPY tsconfig.json ./

# Build packages and web client
RUN pnpm --filter "@hedger/types" run build || true
RUN pnpm --filter "@hedger/format" run build || true
RUN pnpm --filter "@hedger/valuation" run build || true
RUN pnpm --filter "@hedger/charts" run build || true
RUN pnpm --filter "@hedger/ui" run build || true
RUN pnpm --filter "@hedger/web" run build

# ==========================================
# Production Nginx Server
# ==========================================
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
