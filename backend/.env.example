# Hedger Backend Environment Configuration

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hedger?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Data Providers (add your API keys)
# PROVIDER_API_KEY=your_fmp_or_alpha_vantage_key
# PROVIDER_BASE_URL=https://financialmodelingprep.com/api/v3

# FRED API for risk-free rate
# FRED_API_KEY=your_fred_key

# Authentication (for future use)
# JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Job Processing
VALUATION_JOB_CONCURRENCY=5
MARKET_REFRESH_INTERVAL_MS=30000
FINANCIAL_REFRESH_INTERVAL_HOURS=24

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173