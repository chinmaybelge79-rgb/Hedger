# ---- Backend ----
# Postgres connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/hedger

# Redis (cache, rate limiting, job queues)
REDIS_URL=redis://localhost:6379

# REQUIRED in production: secret for signing auth tokens (min 32 chars)
JWT_SECRET=

# Token lifetime
JWT_EXPIRES_IN=7d

# Real market data (optional): Finnhub API key
# When set (with PROVIDER_BASE_URL=https://finnhub.io), live quotes/search are used;
# otherwise the app runs on seeded data.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=

# Risk-free rate source (optional): FRED API key
FRED_API_KEY=

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS origin of the frontend
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Background jobs
VALUATION_JOB_CONCURRENCY=5
MARKET_REFRESH_INTERVAL_MS=30000
FINANCIAL_REFRESH_INTERVAL_HOURS=24

# ---- Frontend ----
# Base URL of the API
VITE_API_BASE=/api/v1
